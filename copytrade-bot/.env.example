# ═══════════════════════════════════════════════════════════════════
#  MEMECOIN COPYTRADE BOT · copia este archivo a .env y rellénalo
# ═══════════════════════════════════════════════════════════════════

# ── LO IMPRESCINDIBLE ───────────────────────────────────────────────
# Wallet(s) del trader a copiar (separadas por comas)
TARGET_WALLETS=PEGA_AQUI_LA_WALLET_DEL_TRADER

# true = simulación con precios reales, NO gasta nada. Déjalo así al menos unos días.
DRY_RUN=true

# Clave privada de una wallet NUEVA solo para el bot (npm run wallet:new). Solo hace falta con DRY_RUN=false.
PRIVATE_KEY=

# RPC: el público es lento y se satura. Usa uno privado (Helius, QuickNode, Triton...). Helius gratis vale para empezar.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=TU_API_KEY
# WS_URL=wss://mainnet.helius-rpc.com/?api-key=TU_API_KEY   (se deduce de RPC_URL si lo dejas vacío)

# ── TAMAÑO DE LAS COMPRAS ───────────────────────────────────────────
# fixed = siempre BUY_AMOUNT_SOL · proportional = COPY_RATIO × lo que compre el trader
BUY_MODE=fixed
BUY_AMOUNT_SOL=0.1
COPY_RATIO=0.1
MIN_BUY_SOL=0.01
MAX_BUY_SOL=0.5
# Ignorar compras del trader más pequeñas que esto (pruebas, polvo, cebos)
MIN_TARGET_BUY_SOL=0.05
# Si el trader vuelve a comprar un token que ya tienes, ¿compras más?
ALLOW_ADD_ON_REBUY=false
# Minutos sin volver a comprar un token que acabas de cerrar (evita entrar y salir en bucle con scalpers)
REBUY_COOLDOWN_MIN=5
# No copiar si nos enteramos más de X segundos tarde (ya habrá subido)
MAX_SIGNAL_AGE_SEC=30
# No copiar si el precio ya ha subido más de este % desde que compró el trader (llegaríamos tarde). 0 = sin límite
MAX_ENTRY_PREMIUM_PCT=25

# ── EJECUCIÓN ───────────────────────────────────────────────────────
# 1500 = 15%. Las memecoins se mueven mucho; con poco slippage fallarán las compras.
SLIPPAGE_BPS=1500
SELL_SLIPPAGE_BPS=2500
# medium | high | veryHigh
PRIORITY_LEVEL=veryHigh
# Tope de priority fee por tx (2_000_000 lamports = 0.002 SOL)
PRIORITY_FEE_MAX_LAMPORTS=2000000
MAX_PRICE_IMPACT_PCT=15
SELL_RETRIES=3
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
# JUPITER_API_KEY=   (si usas api.jup.ag con plan de pago, pon también JUPITER_API_URL=https://api.jup.ag/swap/v1)

# ── SALIDAS ─────────────────────────────────────────────────────────
# Vender cuando el trader vende (en la misma proporción)
MIRROR_SELLS=true
# Si el trader mueve los tokens a otra wallet, tratarlo como venta (suele ser señal de salida)
MIRROR_TRANSFERS_AS_SELL=true
# Take profit: al +100% vende el 50% (recuperas lo invertido y el resto va "gratis"). 0 = desactivado
TAKE_PROFIT_PCT=100
TAKE_PROFIT_SELL_PCT=50
# Stop loss: vende todo si pierde un 40%. 0 = desactivado
STOP_LOSS_PCT=40
# Trailing stop: tras subir un 30%, vende todo si cae un 30% desde el máximo. 0 = desactivado
TRAILING_STOP_PCT=30
TRAILING_ACTIVATION_PCT=30
# Vender todo pasados X minutos (0 = nunca)
MAX_HOLD_MINUTES=0
PRICE_CHECK_INTERVAL_SEC=5

# ── GESTIÓN DE RIESGO ───────────────────────────────────────────────
MAX_OPEN_POSITIONS=5
# Deja de comprar el resto del día si pierdes esto
MAX_DAILY_LOSS_SOL=1
# SOL que siempre se queda en la wallet para fees
MIN_SOL_RESERVE=0.05

# ── FILTROS ANTI-RUG ────────────────────────────────────────────────
REQUIRE_NO_MINT_AUTHORITY=true
REQUIRE_NO_FREEZE_AUTHORITY=true
# Simula vender antes de comprar: si no hay ruta o pierdes demasiado, no compra (honeypots / tax tokens)
CHECK_SELL_ROUTE=true
MAX_ROUNDTRIP_LOSS_PCT=40
# Vía DexScreener. 0 = desactivado
MIN_LIQUIDITY_USD=0
MAX_MARKET_CAP_USD=0
# Mints que nunca comprar (separados por comas)
TOKEN_BLACKLIST=

# ── TELEGRAM (opcional, muy recomendable) ───────────────────────────
# Crea un bot con @BotFather y saca tu chat id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── DETECCIÓN ───────────────────────────────────────────────────────
# Sondeo del saldo del trader por si el WebSocket se pierde algo (segundos)
POLL_INTERVAL_SEC=2
# Máximo de bloques a revisar cuando el sondeo detecta un cambio que el WebSocket no avisó
MAX_BACKFILL_SLOTS=25
# Si el trader cambia de saldo en más bloques que esto por minuto (bot de alta frecuencia), se saltan
MAX_SCANS_PER_MIN=60
# Cada cuánto se mira cuántos tokens le quedan al trader de lo que tenemos (red de seguridad de ventas). 0 = off
SOURCE_CHECK_INTERVAL_SEC=15

# ── OTROS ───────────────────────────────────────────────────────────
STATE_FILE=./data/state.json
LOG_FILE=./data/bot.log
